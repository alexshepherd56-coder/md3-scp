rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // LO Questions images - user-specific access only
    match /loQuestions/{userId}/{questionId}/images/{imageId} {
      // Users can only read their own images
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can only write to their own folder with validation
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024  // 5MB limit
                   && request.resource.contentType.matches('image/(png|jpeg|jpg|gif)');

      // Users can delete their own images
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
